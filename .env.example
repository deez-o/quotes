# Copy to .env.local and fill in from Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
XAI_API_KEY=your-xai-key
# Optional: Google Places (search plants by business name) + Routes (road distance).
# Without it, OpenStreetMap is used: addresses work, business names are hit and miss.
GOOGLE_MAPS_API_KEY=

# Tenant isolation test: a SEPARATE Supabase project used only for tests.
# Put these in .env.test.local (not committed).
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
